{
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/templates/admin.html",
      "destination": "/api/admin"
    },
    {
      "source": "/(.*)",
      "destination": "/api/main.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{templates/**,static/**,backups/**}"
    }
  }
}