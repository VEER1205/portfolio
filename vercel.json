{  
"builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/templates/admin.html",
      "destination": "/api/admin"
    },
    {
      "source": "/(.*)",
      "destination": "/api/main.py"
    }
  ]
}